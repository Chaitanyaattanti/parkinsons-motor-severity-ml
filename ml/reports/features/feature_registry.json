    "category": "first_difference",
    "formula": "sum(|diff(y)|)",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "N >= 4",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
