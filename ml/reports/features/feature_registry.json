[
  {
    "name": "signal_mean",
    "description": "Arithmetic mean of the normalized resistance signal",
    "category": "basic_statistics",
    "formula": "sum(y) / N",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "N >= 4, all finite",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "signal_median",
