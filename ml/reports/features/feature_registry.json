    "validation_status": "exploratory"
  },
  {
    "name": "derivative_rms",
    "description": "RMS rate of change accounting for physical elapsed time",
    "category": "first_difference",
    "formula": "sqrt(mean((diff(y) / diff(t))^2))",
    "unit": "1/s",
    "required_inputs": "signal, time",
    "validity_requirements": "N >= 4, diff(t) > 0",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "robust_amplitude_range",
    "description": "Robust amplitude range between 90th and 10th percentiles",
    "category": "distribution_amplitude",
    "formula": "percentile(y, 90) - percentile(y, 10)",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "N >= 4",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "coefficient_of_variation",
    "description": "Ratio of std to absolute mean; NaN if mean near zero",
    "category": "distribution_amplitude",
    "formula": "std(y) / |mean(y)| if |mean(y)| >= 1e-5 else NaN",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "|mean(y)| >= 1e-5",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "crest_factor",
    "description": "Ratio of peak absolute amplitude to RMS amplitude",
    "category": "distribution_amplitude",
    "formula": "max(|y|) / rms(y)",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "rms(y) > 1e-12",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "zero_crossing_count",
    "description": "Number of mean-centered baseline crossings in trial",
    "category": "zero_crossing",
    "formula": "count(sign(y_centered[i]) != sign(y_centered[i+1]))",
    "unit": "count",
    "required_inputs": "signal_centered",
    "validity_requirements": "N >= 4",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "zero_crossing_rate",
    "description": "Baseline crossings per second of recording",
    "category": "zero_crossing",
    "formula": "zero_crossing_count / duration_s",
    "unit": "1/s",
    "required_inputs": "signal_centered, time",
    "validity_requirements": "duration_s > 0",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "peak_count",
    "description": "Number of prominent peaks detected on centered signal",
    "category": "peak_oscillation",
    "formula": "scipy.signal.find_peaks(y_centered, prominence=0.4*std, distance=0.15s*fs)",
    "unit": "count",
    "required_inputs": "signal_centered, fs",
    "validity_requirements": "N >= 10, std > 1e-12",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "peak_rate_per_sec",
    "description": "Peak count divided by recording duration",
    "category": "peak_oscillation",
    "formula": "peak_count / duration_s",
    "unit": "1/s",
    "required_inputs": "signal_centered, time",
    "validity_requirements": "duration_s > 0",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "peak_prominence_mean",
    "description": "Mean prominence of detected peaks",
    "category": "peak_oscillation",
    "formula": "mean(peak_prominences)",
    "unit": "dimensionless",
    "required_inputs": "signal_centered",
    "validity_requirements": "peak_count >= 1",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "peak_interval_mean_s",
    "description": "Mean time interval between consecutive peaks",
    "category": "peak_oscillation",
    "formula": "mean(diff(peak_times))",
    "unit": "s",
    "required_inputs": "signal_centered, time",
    "validity_requirements": "peak_count >= 2",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "peak_interval_cv",
    "description": "Coefficient of variation of inter-peak intervals (oscillation regularity)",
    "category": "peak_oscillation",
    "formula": "std(diff(peak_times)) / mean(diff(peak_times))",
    "unit": "dimensionless",
    "required_inputs": "signal_centered, time",
    "validity_requirements": "peak_count >= 3",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "dominant_frequency_hz",
    "description": "Dominant frequency within observable frequency band (0.5 to Nyquist)",
    "category": "frequency_domain",
    "formula": "freq[argmax(PSD[0.5 <= f <= Nyquist])]",
    "unit": "Hz",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 2.0, N >= 16",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "spectral_centroid_hz",
    "description": "Center of mass of power spectrum within observable band",
    "category": "frequency_domain",
    "formula": "sum(f * PSD) / sum(PSD)",
    "unit": "Hz",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 2.0, N >= 16",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "spectral_entropy",
    "description": "Normalized spectral entropy of power distribution",
    "category": "frequency_domain",
    "formula": "-sum(p_norm * log2(p_norm)) / log2(n_bins)",
    "unit": "dimensionless",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 2.0, N >= 16",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "band_power_low_0_5_to_3_0_hz",
    "description": "Spectral power in low-frequency voluntary/movement band (0.5 - 3.0 Hz)",
    "category": "frequency_domain",
    "formula": "trapz(PSD[0.5 <= f < 3.0])",
    "unit": "dimensionless^2",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 6.0",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "band_power_parkinsonian_3_0_to_5_0_hz",
    "description": "Spectral power in Parkinsonian resting tremor band (3.0 - 5.0 Hz)",
    "category": "frequency_domain",
    "formula": "trapz(PSD[3.0 <= f <= 5.0])",
    "unit": "dimensionless^2",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 10.0 (Nyquist >= 5.0 Hz)",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "band_power_high_5_0_to_10_0_hz",
    "description": "Spectral power in postural/action tremor band (5.0 - 10.0 Hz). Gated by Nyquist.",
    "category": "frequency_domain",
    "formula": "trapz(PSD[5.0 <= f <= 10.0]) if fs >= 20.0 else NaN",
    "unit": "dimensionless^2",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 20.0 (Nyquist >= 10.0 Hz)",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "tremor_power_ratio",
    "description": "Ratio of Parkinsonian band power (3-5 Hz) to low frequency band power (0.5-3 Hz)",
    "category": "frequency_domain",
    "formula": "band_power_3_to_5_hz / band_power_0_5_to_3_hz",
    "unit": "dimensionless",
    "required_inputs": "signal_detrended, fs",
    "validity_requirements": "fs >= 10.0",
    "task_applicability": "all",
    "validation_status": "exploratory"
  },
  {
    "name": "postural_drift_slope",
    "description": "Linear drift rate over time during sustained posture",
    "category": "task_specific",
    "formula": "polyfit(time, signal, deg=1)[0]",
    "unit": "1/s",
    "required_inputs": "signal, time",
    "validity_requirements": "Arm Extended Forward task, N >= 10",
    "task_applicability": "Arm Extended Forward",
    "validation_status": "exploratory"
  },
  {
    "name": "postural_fatigue_ratio",
    "description": "Ratio of signal RMS in second half to first half of trial",
    "category": "task_specific",
    "formula": "rms(signal[second_half]) / rms(signal[first_half])",
    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "Arm Extended Forward task, N >= 20",
    "task_applicability": "Arm Extended Forward",
    "validation_status": "exploratory"
  },
  {
