    "unit": "dimensionless",
    "required_inputs": "signal",
    "validity_requirements": "Quiet Standing task, N >= 10",
    "task_applicability": "Quiet Standing",
    "validation_status": "exploratory"
  },
  {
    "name": "transition_duration_s",
    "description": "Total duration of functional mobility transition",
    "category": "task_specific",
    "formula": "time_end - time_start",
    "unit": "s",
    "required_inputs": "time",
    "validity_requirements": "Sit-to-Stand, TUG tasks",
